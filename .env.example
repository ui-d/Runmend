ANTHROPIC_API_KEY=sk-ant-your-key-here
# Optional: override the Claude model used for diagnostics (defaults to claude-sonnet-4-5-20250929)
CLAUDE_MODEL=claude-sonnet-4-5-20250929

# Public app URL — used to build absolute redirect URLs (Stripe, email, OAuth callbacks)
NEXT_PUBLIC_APP_URL=http://localhost:3000

NEXT_PUBLIC_POSTHOG_KEY=phc_your-key-here
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Encryption (generate with: openssl rand -hex 32)
ENCRYPTION_KEY=your-64-char-hex-key

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_PRICE_STARTER=price_xxx
STRIPE_PRICE_PRO=price_xxx
STRIPE_PRICE_LTD=price_xxx

# Email (Resend)
RESEND_API_KEY=re_xxx
# Destination inbox for critical LTD refund failures (optional; skips alert if missing)
LTD_ALERT_EMAIL=alerts@your-domain.com
# Sender address for LTD refund alerts (optional; defaults to alerts@runmend.app)
LTD_ALERT_FROM=alerts@your-domain.com

# Vercel Cron (generate with: openssl rand -hex 32)
CRON_SECRET=your-cron-secret

# Sentry
NEXT_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
SENTRY_ORG=your-org
SENTRY_PROJECT=runmend
SENTRY_AUTH_TOKEN=sntrys_xxx
